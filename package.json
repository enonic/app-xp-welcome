{
  "name": "app-sdk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node node_modules/typescript7/bin/tsc && vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --quiet --cache",
    "fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@enonic/ui": "^1.6.0",
    "@nanostores/react": "^2.0.1",
    "@radix-ui/react-slot": "^1.5.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.isequal": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.72.0",
    "nanoid": "^6.0.2",
    "nanostores": "^1.5.5",
    "preact": "^10.29.8",
    "react-use-websocket": "^4.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "devDependencies": {
    "@enonic-types/core": "^8.1.2",
    "@enonic-types/global": "^8.1.2",
    "@enonic-types/lib-admin": "^8.1.2",
    "@enonic-types/lib-auth": "^8.1.2",
    "@enonic-types/lib-i18n": "^8.0.4",
    "@enonic-types/lib-portal": "^8.1.2",
    "@enonic-types/lib-vhost": "^8.1.2",
    "@enonic/eslint-config": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "browserslist-config-enonic": "^1.0.8",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@enonic/eslint-config": {
      "typescript": "$typescript"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/plugin-syntax-flow",
        "@babel/plugin-transform-react-jsx"
      ]
    }
  },
  "browserslist": [
    "extends browserslist-config-enonic"
  ],
  "engines": {
    "node": ">= 26.13.0",
    "npm": ">= 11.20.0"
  }
}
